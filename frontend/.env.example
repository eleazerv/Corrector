NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase login. Leave both empty to run in demo mode (everything on in-browser sample data).
# With both set, the app logs in through Supabase and calls the FastAPI backend for every
# endpoint it has; see ENDPOINTS in src/lib/api/index.ts for which ones are live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
