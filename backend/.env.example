ENV=development

# Database (pool asyncpg, langsung ke Postgres)
DATABASE_URL=

# Supabase Auth
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# Queue
REDIS_URL=
REDIS_API=

# minimal 32 karakter
WORKER_TOKEN=

# ===== LLM =====
#    deepseek | fake
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# batas token output per panggilan
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_JSON_MODE=true
# jumlah panggilan LLM bersamaan per worker
LLM_CONCURRENCY=5

CORS_ORIGINS=["http://localhost:3000"]

# ===== OCR =====
#    api | fake
OCR_PROVIDER=fake

OCR_MAX_IMAGE_SIDE=1600

LANGGRAPH_CHECKPOINT=postgres

#    api | fake
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_DIM=768
EMBEDDING_SEND_DIMENSIONS=true


OCR_PROVIDER=api
OCR_MAX_IMAGE_SIDE=1600

OCR_API_URL=
OCR_API_KEY=

OCR_API_MODE=balanced
OCR_API_TIMEOUT=250